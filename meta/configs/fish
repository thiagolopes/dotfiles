fish_default_key_bindings
bind alt-backspace backward-kill-word
bind alt-delete kill-word
bind ctrl-delete kill-token

alias emacs 'emacs -nw'
alias neofetch fastfetch

alias docker podman
alias docker-compose podman-compose

alias du2 ncdu

alias gst 'git status'

set -gx EDITOR "emacs"
set -gx PATH $HOME/.deno/bin $HOME/.pyenv/bin $HOME/bin /usr/local/bin $HOME/.bin $PATH

set -U fish_greeting

function feh-ls
    feh --montage --thumb-height 200 --thumb-width 200 --index-info "%wx%h" --output .
end

function monitor-brightness -a perc --description "percent (%)"
    set BRIGHTNESS (sudo ddcutil capabilities | grep -e ".*(Brightness)")
    echo $BRIGHTNESS
    set NUMBER_BRIGHTNESS (echo $BRIGHTNESS | awk '{ print $2 }')
    echo "Change monitor brightness ($NUMBER_BRIGHTNESS) to $perc"
    sudo ddcutil setvcp 10 $perc
end

function counter -a times --description "How many times print ."
    if test -d $times
	set times 3
    end
    for x in (seq $times)
	printf "."
	sleep 0.5
    end
    printf "\n"
end

function startx -a wm --description "Which Window Manager X11 to start"
    if test -d $wm
	set wm "i3"
    end
    echo "running $wm"
    counter
    WM=$wm xinit
end

function startwayland -a wm --description "Which Window Manager Wayland to start"
    if test -d $wm
	set wm "sway"
    end
    echo "running $wm"
    counter
    XDG_SESSION_TYPE=wayland dbus-run-session $wm
end

alias ss_tcp 'ss -ltpu'
alias clipboard 'xclip -selection clipboard'
