-- Variables: https://conky.cc/variables
conky.text = [[
${color #ffcb48}$sysname - Kernel $kernel $machine${color}
${color #98c2c7}Uptime:$color $uptime
${color #98c2c7}Frequency:$color $freq (MHz) - $freq_g (GHz)
${color #98c2c7}RAM:$color $mem/$memmax - $memperc% ${color #78af78}${membar 4}$color
${color #78af78}${memgraph}$color
${color #98c2c7}Swap:$color $swap/$swapmax - $swapperc% ${color #78af78}${swapbar 4}$color
${color #98c2c7}CPU:$color $cpu% ${color #78af78}$cpubar$color
${color #78af78}${cpugraph}$color
${color #98c2c7}Processes:$color $processes  ${color #98c2c7}Running:$color $running_processes ${color #98c2c7}Threads:$color $running_threads
${color #98c2c7}File systems: $color${fs_used /}/${fs_size /} ${color #78af78}${fs_bar 6 /}$color
${color #98c2c7}Read:$color $diskio_read
${color #78af78}$diskiograph_read$color
${color #98c2c7}Write:$color $diskio_write
${color #78af78}$diskiograph_write$color
${if_existing /usr/bin/radeontop}
${color #98c2c7}${execi 5 glxinfo -B | grep -oP '(?<=Device: ).*?(?=\()'} Usage: $color${execi 5 radeontop -d- -l1 | grep -o 'gpu [0-9]\{1,3\}' | cut -c 5-}%  ${color #98c2c7}VRAM: $color${execi 5 radeontop -d- -l1 | grep -o 'vram [0-9]\{1,3\}' | cut -c 6-}%
${color #78af78}${execgraph "radeontop -d- -l1 | grep -o 'gpu [0-9]\{1,3\}' | cut -c 5-10"}
${endif}
${color #98c2c7}Networking (enp5s0):
Up:$color ${upspeed enp5s0} ${color #98c2c7} - Down:$color ${downspeed enp5s0}
${color #78af78}$downspeedgraph$color
${color #98c2c7}Name              PID     CPU%   MEM%
${color lightgrey} ${top name 1} ${top pid 1} ${top cpu 1} ${top mem 1}
${color lightgrey} ${top name 2} ${top pid 2} ${top cpu 2} ${top mem 2}
${color lightgrey} ${top name 3} ${top pid 3} ${top cpu 3} ${top mem 3}
${color lightgrey} ${top name 4} ${top pid 4} ${top cpu 4} ${top mem 4}
${color lightgrey} ${top name 5} ${top pid 5} ${top cpu 5} ${top mem 5}
${color lightgrey} ${top name 6} ${top pid 6} ${top cpu 6} ${top mem 6}
]];

