${color #4B5563}${cpugraph ]] .. sizegraph .. [[,}
${cpubar cpu1 ]] .. sizebar .. [[,92} ${cpubar cpu2 ]] .. sizebar .. [[,92} ${cpubar cpu3 ]] .. sizebar .. [[,92} ${cpubar cpu4 ]] .. sizebar .. [[,92}
${cpubar cpu5 ]] .. sizebar .. [[,92} ${cpubar cpu6 ]] .. sizebar .. [[,92} ${cpubar cpu7 ]] .. sizebar .. [[,92} ${cpubar cpu8 ]] .. sizebar .. [[,92}
