export EDITOR="emacs"

# Nvm
export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"

# Python
export PYENV_VIRTUALENVWRAPPER_PREFER_PYVENV="true"
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
export PIP_REQUIRE_VIRTUALENV=true
export WORKON_HOME=$HOME/.virtualenvs
export PROJECT_HOME=$WORK_FOLDER
export PYTHONBREAKPOINT=ipdb.set_trace

export GPG_TTY=$(tty)

export WORK=${HOME}/dev

# To fix the error to open firefox links
export MOZ_DBUS_REMOTE=1

# pgcli
export PGSERVICEFILE=$HOME/.pg_service.conf

# debian maintainer
export DEBFULLNAME="Thiago Lopes"
export DEBEMAIL="thiagolopes@pm.me"

# Path
export PATH=$PATH:$HOME/.poetry/bin
export PATH=$PATH:$HOME/.deno/bin
export PATH=$PATH:$HOME/.pyenv/bin
export PATH=$PATH:/usr/local/bin:$HOME/bin:$HOME/.bin
export PATH=$PATH:$GOROOT/bin:$GOPATH/bin
