#!/usr/bin/sh

ids=$(xinput list | grep -iE "pointer|mouse|touchpad" | cut -d"=" -f2 | cut -d'[' -f1)

for device in $ids; do
    id=$(xinput list-props $device | grep -i "Natural Scrolling Enabled (" | cut -d "(" -f2 | cut -d ")" -f1)
    if [ -n "$id" ]; then
        # echo $device $id
        xinput set-prop "$device" "$id"  1
    fi
done

echo "Natural Scrolling Enabled"
